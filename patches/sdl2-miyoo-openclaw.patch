+/* Platform extension (not stock SDL2 API): let the game mark a texture as
+ * using simple colorkey-cutout transparency (RGB565, one fully-transparent
+ * background color) rather than real per-pixel alpha. See
+ * Image::CreatePcxImage in openclaw-src — it deliberately builds such
+ * textures directly instead of going through SDL_CreateTextureFromSurface,
+ * which would force an ARGB8888 promotion (SDL_CreateTextureFromSurface
+ * treats any surface with SDL_HasColorKey() as needing alpha) and double
+ * the memory for what's the overwhelming majority of the game's sprite art. */
+/* This whole library is built with -fvisibility=hidden by default (SDL2's
+ * own configure.ac), so a plain function definition stays internal/hidden
+ * from the dynamic symbol table unless explicitly marked default-visibility
+ * — same attribute SDL2's own DECLSPEC macro expands to on this platform. */
+__attribute__((visibility("default")))
+int MMIYOO_SetTextureColorKey(SDL_Texture *texture, Uint32 colorkey)
+{
+    MMIYOO_TextureData *tex_data = texture ? (MMIYOO_TextureData *)texture->driverdata : NULL;
+
+    if (!tex_data) {
+        return -1;
+    }
+
+    tex_data->has_colorkey = SDL_TRUE;
+    tex_data->colorkey = colorkey;
+    return 0;
+}
