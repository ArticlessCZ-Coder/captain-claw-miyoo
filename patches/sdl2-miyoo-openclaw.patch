diff --git a/sdl2/include/SDL_mmiyoo_ext.h b/sdl2/include/SDL_mmiyoo_ext.h
new file mode 100644
index 00000000..17a79c31
--- /dev/null
+++ b/sdl2/include/SDL_mmiyoo_ext.h
@@ -0,0 +1,48 @@
+/*
+  Miyoo Mini platform extension — not part of stock SDL2.
+
+  Lets a game mark a texture as using simple colorkey-cutout transparency
+  (one fully-transparent background color, no real per-pixel alpha) so the
+  "mmiyoo" render backend can keep it in RGB565 (half the memory of
+  ARGB8888) and use the SigmaStar MI_GFX 2D block's own hardware colorkey
+  matching instead of alpha blending. Only meaningful when SDL_VIDEODRIVER=
+  mmiyoo / SDL_RENDER_DRIVER=mmiyoo are active; harmless no-op call on any
+  other platform/backend if guarded by #ifdef MIYOO_MINI at the call site,
+  since this header (and the symbol) only exists in this custom build.
+*/
+#ifndef SDL_mmiyoo_ext_h_
+#define SDL_mmiyoo_ext_h_
+
+/* Deliberately #include-free (no SDL_stdinc.h/SDL_render.h/etc): the game may
+ * already have a *different* SDL2 header tree in its include path by the
+ * time it includes this file (e.g. a bundled ThirdParty/SDL2 copy alongside
+ * this build's own sysroot headers), and pulling in this build's copies of
+ * those headers redefines every SDL_* type/inline function against whatever
+ * that other tree already declared (SDL_Texture, SDL_DUMMY_ENUM,
+ * SDL_memcpy4, ...). Stick to plain C types and an opaque struct tag —
+ * "unsigned int" instead of Uint32 for the same reason.
+ *
+ * Also deliberately not wrapped through SDL_DYNAPI (SDL_dynapi_overrides.h /
+ * SDL_dynapi_procs.h) — it's not part of the stock SDL2 API surface, just a
+ * plain exported symbol in this custom libSDL2 that the game links against
+ * directly. */
+struct SDL_Texture;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ *  Mark `texture` as using colorkey-cutout transparency: pixels matching
+ *  `colorkey` (packed in the texture's own pixel format, e.g. via
+ *  SDL_MapRGB against an RGB565 SDL_PixelFormat) are skipped by MI_GFX at
+ *  blit time. Returns 0 on success, -1 if the texture has no mmiyoo
+ *  driverdata (e.g. wrong renderer backend).
+ */
+extern int MMIYOO_SetTextureColorKey(struct SDL_Texture *texture, unsigned int colorkey);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SDL_mmiyoo_ext_h_ */
