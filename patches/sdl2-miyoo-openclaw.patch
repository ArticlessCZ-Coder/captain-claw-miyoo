+     * This used to sleep for the frame duration minus a fixed 10 ms and assume
+     * that matched playback. It does not: a frame holds 23.2 ms of audio at the
+     * game's settings but was handed over every ~13 ms plus callback time, so
+     * the driver produced roughly 15% faster than the hardware consumed. The
+     * queue filled steadily - measured going 14544 -> 26752 -> 38968 -> 51176
+     * -> 65024 bytes over five seconds - and then stayed pinned at its
+     * 65536-byte ceiling. A permanently full queue is a permanent delay of its
+     * entire depth, about 0.7s between an action and its sound, and it is why
+     * shrinking the SDL buffer, u32FrmNum and the mixer rate all changed
+     * nothing audible: the queue simply refilled to the same ceiling.
+     *
+     * Waiting until only a few frames are left caps the latency there, and
+     * self-corrects for any frame size or sample rate. The iteration cap means
+     * a failing QueryChnStat degrades to the old fixed pacing instead of
+     * hanging the audio thread. */
+    {
+        const MI_U32 targetBytes = (MI_U32)this->hidden->mixlen * 3;   /* ~70 ms */
+        int guard = 0;
+
+        for (guard = 0; guard < 100; guard++) {
+            MI_AO_ChnState_t stState;
+
+            if (MI_AO_QueryChnStat(AoDevId, AoChn, &stState) != MI_SUCCESS) {
+                usleep(((stSetAttr.u32PtNumPerFrm * 1000) / stSetAttr.eSamplerate - 10) * 1000);
+                break;
+            }
+
+            if (stState.u32ChnBusyNum <= targetBytes) {
+                break;
+            }
+
+            usleep(2000);
+        }
+    }
 #endif
 
